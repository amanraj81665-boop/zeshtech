# ==============================================================================
# ZESH-TECH — Production Environment Configuration Template
# Duplicate this file to .env and configure with your production credentials.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.bkncydl.mongodb.net/zeshtech_pos?retryWrites=true&w=majority

# JWT Authentication Secret (Generate a 64+ char random hex string)
JWT_SECRET=your_super_secret_jwt_key_here

# Store Administrator Email
ADMIN_EMAIL=admin@zeshtech.com

# Real Email Delivery via Gmail SMTP or Custom SMTP (for Password Reset OTP)
EMAIL_SERVICE=gmail
EMAIL_USER=your-store-gmail@gmail.com
EMAIL_PASS=your_16_character_google_app_password
# Optional Custom SMTP settings (if not using Gmail):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM=ZESH-TECH Security <support@zeshtech.com>

# Google Identity Services (GIS) Web Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com

# Cloudinary Storage Credentials for Product Images
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
