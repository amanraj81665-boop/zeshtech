# ==============================================================================
# ZESH-TECH — Production Environment Configuration Template
# Duplicate this file to .env and configure with your production credentials.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.bkncydl.mongodb.net/zeshtech_pos?retryWrites=true&w=majority

# JWT Authentication Secret (Generate a 64+ char random hex string)
JWT_SECRET=your_super_secret_jwt_key_here

# Store Administrator Email
ADMIN_EMAIL=admin@zeshtech.com

# Cloudinary Storage Credentials for Product Images
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
